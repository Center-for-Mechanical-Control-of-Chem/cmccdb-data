reactions {
  identifiers {
    type: REACTION_TYPE
    value: "copper-catalysed alkyne\342\200\223azide click-coupling"
  }
  inputs {
    key: "inputs-bdfa4b"
    value {
      components {
        identifiers {
          type: SMILES
          value: "BrCC1=CC=CC=C1"
        }
        amount {
          moles {
            value: 2.0
            units: MILLIMOLE
          }
        }
        reaction_role: REACTANT
      }
      components {
        identifiers {
          type: SMILES
          value: "C#CC1=CC=CC=C1"
        }
        amount {
          moles {
            value: 2.0
            units: MILLIMOLE
          }
        }
        reaction_role: REACTANT
      }
      components {
        identifiers {
          type: NAME
          value: "Cu Coil"
        }
        amount {
          unmeasured {
            type: CATALYTIC
          }
        }
        reaction_role: CATALYST
      }
      components {
        identifiers {
          type: SMILES
          value: "[N-]=N#N.[Na+]"
        }
        amount {
          moles {
            value: 3.0
            units: MILLIMOLE
          }
        }
        reaction_role: REACTANT
      }
      components {
        identifiers {
          type: SMILES
          value: "O=S(C)C"
        }
        amount {
          volume {
            value: 0.5
            units: MICROLITER
          }
        }
        reaction_role: ADDITIVE
      }
    }
  }
  conditions {
    mechanochemistry {
      type: RESONANT_ACOUSTIC_MIXING
      duration {
        value: 3600.0
        units: SECOND
      }
      g_force {
        value: 90.0
        units: STANDARD_GRAVITATIONAL_ACCELERATION
      }
    }
  }
  outcomes {
    products {
      identifiers {
        type: SMILES
        value: "c1(Cn2nnc(c3ccccc3)c2)ccccc1"
      }
      measurements {
